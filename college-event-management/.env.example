# Copy to .env and set unique values before running outside local development.
API_PORT=3001
DB_PATH=server/data/campus.sqlite
JWT_SECRET=

# Optional first administrator, created only when both values are set.
ADMIN_NAME=Campus administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local simulation only; ignored in production. Set to blank for Stripe-only behavior.
PAYMENTS_MODE=demo

# Optional Stripe Checkout. Configured Stripe takes precedence over demo mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional registration and waitlist email confirmations via Resend.
RESEND_API_KEY=
EMAIL_FROM=
